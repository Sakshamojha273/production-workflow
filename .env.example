# SmartPlan AI Environment Variables

# Application
APP_NAME=SmartPlan AI
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartplan
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/smartplan

# Security
# SECRET_KEY signs the login JWT that every /api route (except /api/auth/*) requires.
# Use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# The backend logs a warning at startup while it is still this placeholder.
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=["text/csv","application/csv"]

# ML Models
# ML_MODEL_PATH defaults to backend/models (=/app/models in Docker)
# ML_MODEL_PATH=/app/models
FORECAST_DEFAULT_HORIZON=7
FORECAST_MAX_HORIZON=30
FORECAST_INTERVAL_LEVEL=0.80
FORECAST_MIN_HISTORY=30

# Frontend
# Option A (default, recommended for `npm run dev`): leave VITE_API_URL unset so the
# app calls /api and the Vite dev server proxies it to VITE_API_PROXY_TARGET
# (default http://localhost:8000). Put it in frontend/.env.local, e.g.
#   VITE_API_PROXY_TARGET=http://localhost:8001
# Option B: call the backend directly (needs CORS_ORIGINS to include the frontend):
# VITE_API_URL=http://localhost:8000/api